//                           | |             | |/ _|
//       __ _  ___   ___   __| |_      _____ | | |_ 
//      / _` |/ _ \ / _ \ / _` \ \ /\ / / _ \| |  _|
//     | (_| | (_) | (_) | (_| |\ V  V / (_) | | |  
//      \__, |\___/ \___/ \__,_| \_/\_/ \___/|_|_|  
//       __/ |                                      
//      |___/                                       
//
//
//     :syntax less
//     :set background=dark
//
// A VS Code colorscheme ported by Ryan Olson.
//
// Colors used:

// The most basic of all our colors is a slightly tweaked version of the Molokai
// Normal text.
// "plain": "#f8f6f2",
//
// Pure and simple.
// "snow": "#ffffff",
// "coal": "#000000",
//
// All of the Gravel colors are based on a brown from Clouds Midnight.
// "brightgravel": "#d9cec3",
// "lightgravel": "#998f84",
// "gravel": "#857f78",
// "mediumgravel": "#666462",
// "deepgravel": "#45413b",
// "deepergravel": "#35322d",
// "darkgravel": "#242321",
// "blackgravel": "#1c1b1a",
// "blackestgravel": "#141413",
//
// A color sampled from a highlight in a photo of a glass of Dale's Pale Ale on
// my desk.
// "dalespale": "#fade3e",
//
// A beautiful tan from Tomorrow Night.
// "dirtyblonde": "#f4cf86",
//
// Delicious, chewy red from Made of Code for the poppiest highlights.
// "taffy": "#ff2c4b",
//
// Another chewy accent, but use sparingly!
// "saltwatertaffy": "#8cffba",
//
// The star of the show comes straight from Made of Code.
//
// You should almost never use this.  It should be used for things that denote
// 'where the user is', which basically consists of:
//
// * The cursor
// * A REPL prompt
// "tardis": "#0a9dff",
//
// This one's from Mustang, not Florida!
// "orange": "#ffa724",
//
// A limier green from Getafe.
// "lime": "#aeee00",
//
// Rose's dress in The Idiot's Lantern.
// "dress": "#ff9eb8",
// 
// Another play on the brown from Clouds Midnight.  I love that color.
// "toffee": "#b88853",
// 
// Also based on that Clouds Midnight brown.
// "coffee": "#c7915b",
// "darkroast": "#88633f",
{
  "name": "Good Wolf (Dark)",
  "colors": {
    "editor.background": "#141413",                     // blackestgravel
    "editor.foreground": "#f8f6f2",                     // plain
    "activityBarBadge.background": "#0a9dff",           // tardis
    "editorCursor.foreground": "#0a9dff",               // tardis
    "editorBracketHighlight.foreground1": "#f8f6f2",    // plain
    "editorBracketHighlight.foreground2": "#f8f6f2",    // plain
    "editorBracketHighlight.foreground3": "#f8f6f2",    // plain
    "statusBar.background": "#0a9dff",                  // tardis
    "statusBar.foreground": "#000000",                  // coal
    "editorGutter.background": "#1c1b1a",               // blackgravel
    "editorLineNumber.foreground": "#666462",           // mediumgravel
    "editor.lineHighlightBackground": "#242321",        // darkgravel
    "editor.selectionBackground": "#45413b",            // deepgravel
    "editor.findMatchBackground": "#fade3e44",          // dalespale-ish
    "editor.findMatchHighlightBackground": "#fade3e22", // dalespale-ish
  },
  "tokenColors": [{
    "name": "Comment",
    "scope": "comment",
    "settings": {
      "foreground": "#857f78" // gravel
    }
  },
  {
    "name": "String",
    "scope": "string",
    "settings": {
      "foreground": "#998f84", // lightgravel
      "fontStyle": "bold"
    }
  },
  {
    "name": "HTMLtag < or > punctuation",
    "scope": "punctuation.definition.tag.begin, punctuation.definition.tag.end",
    "settings": {
      "foreground": "#88633f" // darkroast
    }
  },
  {
    "name": "HTML tag",
    "scope": "entity.name.tag",
    "settings": {
      "foreground": "#c7915b", // coffee
      "fontStyle": "bold"
    }
  },
  {
    "name": "HTML attribute",
    "scope": "entity.other.attribute-name",
    "settings": {
      "foreground": "#c7915b" // coffee
    }
  },
  {
    "name": "Function keyword",
    "scope": "storage.type.function, keyword.declaration.function",
    "settings": {
      "fontStyle": "bold"
    }
  },
  {
    "name": "markup punctuation",
    "scope": "markup.heading punctuation.definition.heading, punctuation.definition.markdown",
    "settings": {
      "foreground": "#998f84", // lightgravel
      "fontStyle": "bold"
    }
  },
  {
    "name": "markup h1",
    "scope": "markup.heading.1 entity.name.section",
    "settings": {
      "foreground": "#ffa724", // orange
      "fontStyle": "bold"
    }
  },
  {
    "name": "markup h2",
    "scope": "markup.heading.2 entity.name.section",
    "settings": {
      "foreground": "#aeee00", // lime
      "fontStyle": "bold"
    }
  },
  {
    "name": "markup hn",
    "scope": "markup.heading entity.name.section",
    "settings": {
      "foreground": "#aeee00", // lime
      "fontStyle": ""
    }
  },
  {
    "name": "markup links",
    "scope": "markup.underline.link",
    "settings": {
      "foreground": "#b88853", // toffee
      "fontStyle": "bold"
    }
  },
  {
    "name": "markup link text",
    "scope": "meta.link.inline.description",
    "settings": {
      "foreground": "#b88853", // toffee
      "fontStyle": "underline"
    }
  },
  {
    "name": "markup bold",
    "scope": "markup.bold",
    "settings": {
      "foreground": "#ffffff", // snow
      "fontStyle": "bold"
    }
  },
  {
    "name": "markup italic",
    "scope": "markup.italic",
    "settings": {
      "foreground": "#ffffff", // snow
      "fontStyle": "italic"
    }
  },
  {
    "name": "markup underline",
    "scope": "markup.underline",
    "settings": {
      "fontStyle": "underline"
    }
  },
  {
    "name": "markup bold/italic",
    "scope": "markup.italic markup.bold | markup.bold markup.italic",
    "settings": {
      "foreground": "#ffffff", // snow
      "fontStyle": "bold italic"
    }
  },
  {
    "name": "markup bold/underline",
    "scope": "markup.underline markup.bold | markup.bold markup.underline",
    "settings": {
      "foreground": "#ffffff", // snow
      "fontStyle": "bold underline"
    }
  },
  {
    "name": "markup italic/underline",
    "scope": "markup.underline markup.italic | markup.italic markup.underline",
    "settings": {
      "foreground": "#ffffff", // snow
      "fontStyle": "italic underline"
    }
  },
  {
    "name": "markup bold/italic/underline",
    "scope": "markup.bold markup.italic markup.underline | markup.bold markup.underline markup.italic | markup.italic markup.bold markup.underline | markup.italic markup.underline markup.bold | markup.underline markup.bold markup.italic | markup.underline markup.italic markup.bold",
    "settings": {
      "foreground": "#ffffff", // snow
      "fontStyle": "bold italic underline"
    }
  },
  {
    "name": "markup bullets",
    "scope": "markup.list.numbered.bullet",
    "settings": {
      "foreground": "#998f84" // lightgravel
    }
  },
  {
    "name": "markup bullets",
    "scope": "markup.list.unnumbered.bullet | (markup.list.numbered punctuation.definition)",
    "settings": {
      "foreground": "#998f84" // lightgravel
    }
  },
  {
    "name": "markup code",
    "scope": "markup.raw",
    "settings": {
      "foreground": "#f4cf86" // dirtyblonde
    }
  },
  {
    "name": "diff.deleted",
    "scope": "markup.deleted",
    "settings": {
      "foreground": "#ff9eb8" // dress
    }
  },
  {
    "name": "diff.inserted",
    "scope": "markup.inserted",
    "settings": {
      "foreground": "#aeee00" // lime
    }
  },
  {
    "name": "diff.changed",
    "scope": "markup.changed",
    "settings": {
      "foreground": "#ffa724" // orange
    }
  }]
}
